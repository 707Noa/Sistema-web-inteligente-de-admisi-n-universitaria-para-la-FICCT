# Variables mínimas de despliegue (archivo raíz)
# Mantén secretos y variables específicas del servicio
# en `backend/.env` y `frontend/.env`.

# Entorno: 'local' o 'prod'
APP_ENV=local

# Dominios públicos (usados por nginx y certbot)
FRONTEND_DOMAIN=app-primerpacialswsi.duckdns.org
API_DOMAIN=api-primerpacialswsi.duckdns.org

# Certbot
CERTBOT_EMAIL=tu_correo@gmail.com
# Nombre del certificado (archivo live/<name> en letsencrypt)
CERTBOT_CERT_NAME=app-primerpacialswsi.duckdns.org
# Lista de dominios separados por espacio. Ej:
# CERTBOT_DOMAINS="app-primerpacialswsi.duckdns.org api-primerpacialswsi.duckdns.org"
CERTBOT_DOMAINS="app-primerpacialswsi.duckdns.org api-primerpacialswsi.duckdns.org"

# Puertos y servicios orquestación
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# Nota: secretos (JWT, DB, etc.) deben quedar en `backend/.env`.
